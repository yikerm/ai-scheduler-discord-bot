# 將本檔複製為 .env，填入私密設定；不要提交 .env。
DISCORD_BOT_TOKEN=
GEMINI_API_KEY=

# Bot 唯一會建立、更新與刪除事件的 Google Calendar ID。
CALENDAR_ID=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# 排程需要避開的其他 Calendar ID，以及只讀 iCal/ICS（皆以逗號分隔）。
BUSY_CALENDAR_IDS=
EXTERNAL_CALENDAR_URLS=

# 單一 Discord 使用者與排程範圍。
DISCORD_USER_ID=
PLANNING_HORIZON_DAYS=7
REPEAT_HORIZON_DAYS=14

# 自然語言、多日重排與通知安全設定。
NLP_PENDING_MINUTES=10
MAX_REPLAN_MOVES=3
SCHEDULE_NOTIFICATION_COOLDOWN_HOURS=24

# ML 逐步啟用門檻。
ML_PROGRESSIVE_MIN_FEEDBACK=20
ML_FULL_FEEDBACK=50
